{
  "name": "neolift-mobile",
  "version": "1.6.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "manifest": "node scripts/generate-manifest.mjs",
    "sync:exercises": "node scripts/sync-exercises.mjs",
    "typecheck": "tsc --noEmit",
    "deps:check": "node scripts/metro-check.mjs && node scripts/security-check.mjs",
    "release:check": "node scripts/release-check.mjs && npm run deps:check",
    "security:check": "npm run deps:check && npm audit",
    "vendor:pack:image-size": "npm pack ./vendor/image-size --pack-destination ./vendor",
    "eas-build-post-install": "npm run release:check && npm run typecheck"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-three/fiber": "^9.7.0",
    "expo": "~57.0.12",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "image-size": "file:vendor/image-size-2.0.3-neolift.1.tgz",
    "queue": "6.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/three": "^0.185.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "image-size": "file:vendor/image-size-2.0.3-neolift.1.tgz",
    "uuid": "11.1.1"
  }
